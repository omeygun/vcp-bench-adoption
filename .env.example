# Storage: leave MONGODB_URI unset to use the local JSON file store (.data/db.json)
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=vcp-benches
# Auth
AUTH_SECRET=change-me-long-random
AUTH_URL=https://benches.example.org
ADMIN_KEY=change-me-for-scripts
# First admin: used only until a staff password exists, then manage accounts in /admin/staff
ADMIN_EMAIL=first.admin@vancortlandt.org
ADMIN_PASSWORD=change-me-10-plus-chars
# Email (optional; without it donor/report/reminder emails are logged to the server console)
RESEND_API_KEY=
EMAIL_FROM="VCP Benches <benches@vancortlandt.org>"
VCPA_NOTIFY_EMAIL=info@vancortlandt.org
# Cron + Stripe (optional)
CRON_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
